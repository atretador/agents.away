#!/usr/bin/env bash
# Create a private CA (once) and a server certificate for this machine's addresses.
# Re-run whenever the PC's IP changes; the phone only needs the CA installed once.
set -euo pipefail
DIR="${AWAY_CONFIG_DIR:-$HOME/.config/agents-away}/certs"
mkdir -p "$DIR"; chmod 700 "$DIR"; cd "$DIR"

# --new-ca: replace the CA (the phone then has to install the new one; remove the old one there).
if [[ "${1:-}" == "--new-ca" ]]; then rm -f ca.key ca.crt ca.srl; fi

if [[ ! -f ca.key ]]; then
  # Name constraints: this CA can only vouch for private addresses and this PC's own names, so even if
  # its key leaked it couldn't be used to impersonate other websites to the phone.
  h=$(uname -n)
  nc="permitted;IP:10.0.0.0/255.0.0.0,permitted;IP:172.16.0.0/255.240.0.0,permitted;IP:192.168.0.0/255.255.0.0"
  nc="$nc,permitted;IP:100.64.0.0/255.192.0.0,permitted;IP:127.0.0.0/255.0.0.0,permitted;IP:169.254.0.0/255.255.0.0"
  nc="$nc,permitted;DNS:localhost,permitted;DNS:$h,permitted;DNS:$h.local,permitted;DNS:.local,permitted;DNS:.lan,permitted;DNS:.home.arpa"
  openssl req -x509 -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes \
    -keyout ca.key -out ca.crt -days 3650 -subj "/CN=Agents Away local CA ($h)" \
    -addext "basicConstraints=critical,CA:TRUE,pathlen:0" -addext "keyUsage=critical,keyCertSign,cRLSign" \
    -addext "nameConstraints=critical,$nc" 2>/dev/null
  echo "Created CA: $DIR/ca.crt"
fi

host=$(uname -n)
san="DNS:localhost,DNS:$host,DNS:$host.local,IP:127.0.0.1"
for ip in $(ip -4 -o addr show | awk '{print $2" "$4}' | grep -Ev '^(lo|docker|br-|virbr|veth)' | awk '{print $2}' | cut -d/ -f1); do
  san="$san,IP:$ip"
done

openssl req -newkey ec -pkeyopt ec_paramgen_curve:prime256v1 -nodes -keyout server.key -out server.csr \
  -subj "/CN=$host" 2>/dev/null
openssl x509 -req -in server.csr -CA ca.crt -CAkey ca.key -CAcreateserial -out server.crt -days 800 \
  -extfile <(printf "subjectAltName=%s\nbasicConstraints=CA:FALSE\nkeyUsage=critical,digitalSignature\nextendedKeyUsage=serverAuth\n" "$san") 2>/dev/null
rm -f server.csr
chmod 600 *.key
echo "Server certificate for: $san"
echo "CA fingerprint (SHA-256): $(openssl x509 -in ca.crt -noout -fingerprint -sha256 | cut -d= -f2)"
